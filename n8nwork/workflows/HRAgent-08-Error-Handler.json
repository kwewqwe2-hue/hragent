      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json ?? {};\nconst workflow = payload.workflow ?? {};\nconst execution = payload.execution ?? {};\nconst node = payload.node ?? {};\nconst error = payload.error ?? {};\nconst message = String(error.message ?? payload.message ?? 'n8n workflow failed')\n  .replace(/[\\r\\n]+/g, ' ')\n  .slice(0, 1000);\nreturn [{\n  json: {\n    workflowName: String(workflow.name ?? 'unknown workflow').slice(0, 160),\n    workflowId: workflow.id ? String(workflow.id).slice(0, 160) : undefined,\n    executionId: execution.id ? String(execution.id).slice(0, 160) : undefined,\n    lastNode: node.name ? String(node.name).slice(0, 160) : undefined,\n    message,\n    occurredAt: new Date().toISOString(),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "id": "f2a6c9d4-1e83-4b57-8f20-6c3d9a7e5b12",
      "name": "Normalize Error"
    },
    {
