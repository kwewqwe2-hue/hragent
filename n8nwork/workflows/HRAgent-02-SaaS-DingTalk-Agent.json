        "jsCode": "const output = typeof $json.output === 'string' ? $json.output.trim() : '';\nconst errorMessage = String($json.error?.message || $json.error || '').trim();\nlet replyText = output;\nif (!replyText && errorMessage) {\n  if (/service unavailable|temporarily unavailable|503|timeout|timed out|ECONNRESET|ETIMEDOUT/i.test(errorMessage)) {\n    replyText = 'DeepSeek 服务暂时不可用，系统已自动重试；请稍后重新发送。';\n  } else {\n    replyText = '智能体处理失败，请稍后重试。错误信息：' + errorMessage.slice(0, 180);\n  }\n}\nreplyText = replyText || '本次处理没有得到有效结果，请稍后重试；如持续失败，请联系系统管理员。';\nreturn [{ json: { replyText } }];"
