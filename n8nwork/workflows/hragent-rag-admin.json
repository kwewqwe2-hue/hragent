        "url": "=http://qdrant:6333/collections/{{ $('Normalize Delete Request').first().json.collection }}/points/delete",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n    \"filter\": {\n        \"must\": [\n            {\n                \"key\": \"metadata.filter_by_filename\",\n                \"match\": {\n                    \"value\": \"{{ $('Normalize Delete Request').first().json.filePath }}\"\n                }\n            }\n        ]\n    }\n}",
        "authentication": "predefinedCredentialType",
