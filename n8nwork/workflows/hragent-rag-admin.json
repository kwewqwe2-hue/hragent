      "name": "Delete Knowledge Vectors"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const request = $('Normalize Delete Request').first().json;\nconst found = $('Find Knowledge Vectors').first().json.result?.points || [];\nreturn [{ json: { success: true, fileName: request.fileName, deletedPoints: found.length, deletedSourceFile: true, message: 'Knowledge vectors and source file deleted' } }];"
      },
