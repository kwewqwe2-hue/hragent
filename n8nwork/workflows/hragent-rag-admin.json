    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $json.body || $json;\nconst fileName = String(body.fileName || '').trim();\nif (!fileName) throw new Error('fileName is required');\nif (fileName.includes('/') || fileName.includes('\\\\') || fileName.includes('..') || fileName.includes('\\\\0')) {\n  throw new Error('fileName must be a single file name');\n}\nreturn [{ json: { fileName, filePath: '/knowledge-files/' + fileName, collection: 'hragent_knowledge' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "id": "e5f60718-293a-4b5c-8d6e-7f8091a2b3c4",
      "name": "Normalize Delete Request"
    },
    {
      "parameters": {
        "url": "=http://qdrant:6333/collections/{{ $json.collection }}/points/scroll",
        "method": "POST",
        "options": {},
        "jsonBody": "={\n    \"filter\": {\n        \"must\": [\n            {\n                \"key\": \"metadata.filter_by_filename\",\n                \"match\": {\n                    \"value\": \"{{ $json.filePath }}\"\n                }\n            }\n        ]\n    },\n    \"limit\": 1000,\n    \"with_payload\": false,\n    \"with_vector\": false\n}",
        "sendBody": true,
        "specifyBody": "json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "qdrantApi"
      },
      "credentials": {
        "qdrantApi": {
          "id": "ChDPz6xXj1Fal8N9",
          "name": "Qdrant account"
        }
      },
