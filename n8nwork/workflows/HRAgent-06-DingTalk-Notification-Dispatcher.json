{
  "name": "HRAgent-06-DingTalk-Notification-Dispatcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "7dc4c020-12bb-43a2-aeb3-a841fd9297de",
      "name": "Every minute"
    },
    {
      "parameters": {
        "url": "={{ $env.SAAS_BASE_URL + '/internal/agent/v1/notifications/pending?limit=20' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.SAAS_AGENT_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        240,
        0
      ],
      "id": "2aa72ecf-c1e2-4a51-8903-ff03d6045555",
      "name": "Get Pending Notifications"
    },
    {
      "parameters": {
        "jsCode": "const notifications = $input.first().json.data ?? [];\nreturn notifications.map((notification) => ({ json: notification }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "28409f73-905e-41ca-bcf5-85b4db5a4bd1",
      "name": "Expand Notifications"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.dingtalk.com/v1.0/oauth2/accessToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({appKey:$env.DINGTALK_APP_KEY,appSecret:$env.DINGTALK_APP_SECRET,}) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        720,
        0
      ],
      "id": "8424c3cf-86f7-486e-9dc0-e7215c65f0df",
      "name": "Get DingTalk Access Token"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.dingtalk.com/v1.0/robot/oToMessages/batchSend",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-acs-dingtalk-access-token",
              "value": "={{ $json.accessToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const notification = $('Expand Notifications').item.json; const base = ($env.DINGTALK_APPROVAL_BASE_URL || $env.WEBHOOK_URL || '').replace(/\\/+$/, ''); const page = base + '/webhook/hragent-dingtalk-leave-card'; const hasCard = notification.eventType === 'LEAVE_SUBMITTED' && notification.approveToken && notification.rejectToken && base; const pageUrl = page + '?approveToken=' + encodeURIComponent(notification.approveToken || '') + '&rejectToken=' + encodeURIComponent(notification.rejectToken || ''); const msgParam = hasCard ? {title:'请假审批',text:notification.message,singleTitle:'处理审批',singleURL:pageUrl} : {content:notification.message}; return {robotCode:$env.DINGTALK_APP_KEY,userIds:[notification.dingtalkStaffId],msgKey:hasCard?'sampleActionCard':'sampleText',msgParam:JSON.stringify(msgParam)}; })() }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        960,
        0
      ],
      "id": "6e79a88f-8f95-4032-9c37-ae5a781445da",
      "name": "Send DingTalk Notification",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SAAS_BASE_URL + '/internal/agent/v1/notifications/' + $('Expand Notifications').item.json.id + '/delivered' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.SAAS_AGENT_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1200,
        0
      ],
      "id": "6ebd397e-c479-4180-ab62-dbdc94e5a868",
      "name": "Mark Notification Delivered"
    }
  ],
  "pinData": {},
  "connections": {
