      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1248,
        224
      ],
      "id": "5ea91fe2-a523-47b8-879a-634f6f79d4e1",
      "name": "OCR Image"
    },
    {
      "parameters": {
        "jsCode": "const source = $('Switch').first().json;\nconst fileName = String(source.fileName || 'upload.bin');\nconst rawText = String($json.text ?? '').trim();\nconst maxChars = 60000;\n\nif (!$json.success) {\n  throw new Error('图片 OCR 处理失败，请稍后重试');\n}\n\nif (!rawText) {\n  throw new Error('图片中没有识别到可读文字，请上传更清晰的 JPG、JPEG 或 PNG 图片');\n}\n\nreturn [{\n  json: {\n    fileName,\n    fileType: fileName.toLowerCase().endsWith('.png') ? 'png' : 'jpg',\n    extractedText: rawText.slice(0, maxChars),\n    truncated: rawText.length > maxChars,\n    originalLength: rawText.length,\n    ocrLineCount: Number($json.lineCount || 0),\n    ocrAverageConfidence: $json.averageConfidence ?? null,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        224
      ],
      "id": "8251585a-6457-4ba8-a223-0fd474fd85b1",
      "name": "Format OCR Result"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hragent-web-attachment-parse",
        "responseMode": "lastNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        -320
      ],
      "id": "ac810adb-9597-4215-be14-a27076b84689",
      "name": "Web Attachment Upload",
      "webhookId": "786e83f1-463f-4493-8d87-d3a1e94ee212"
    },
    {
      "parameters": {
        "jsCode": "const expected = String($env.WEB_ATTACHMENT_INTERNAL_KEY || '');\nconst supplied = String($json.headers?.['x-hragent-internal-key'] || '');\n\nif (!expected || supplied !== expected) {\n  throw new Error('网页附件解析请求未通过内部鉴权');\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        -320
      ],
      "id": "1f73a94f-964e-4e8e-b619-35b88927324b",
      "name": "Authorize Web Attachment",
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binary = item.binary?.data;\n\nif (!binary) {\n  throw new Error('网页附件请求没有包含 data 文件字段');\n}\n\nconst fileName = String(binary.fileName || item.json.body?.fileName || 'upload.bin')\n  .replaceAll('/', '_')\n  .split(String.fromCharCode(92)).join('_')\n  .replaceAll('..', '_');\n\nif (!fileName || fileName === 'upload.bin') {\n  throw new Error('网页附件缺少有效文件名');\n}\n\nitem.json = {\n  ...item.json,\n  source: 'web',\n  fileName,\n};\nitem.binary = { data: binary };\nreturn [item];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        -320
      ],
      "id": "549fe713-acd9-4bc6-8c3c-44cf3da6b37b",
      "name": "Normalize Web Attachment"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binary = item.binary?.data;\n\nif (!binary) {\n  throw new Error('钉钉附件下载结果没有包含文件内容');\n}\n\nconst fileName = String($('When Executed by Another Workflow').first().json.fileName || binary.fileName || 'dingtalk-file.bin')\n  .replaceAll('/', '_')\n  .split(String.fromCharCode(92)).join('_')\n  .replaceAll('..', '_');\n\nitem.json = { source: 'dingtalk', fileName };\nitem.binary = { data: binary };\nreturn [item];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        0
      ],
      "id": "9f985b54-f59f-44c4-b24f-6eeca077b782",
      "name": "Normalize DingTalk Attachment"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binary = item.binary?.data;\n\nif (!binary) {\n  throw new Error('DOCX 文件内容为空');\n}\n\nconst originalName = String(item.json.fileName || binary.fileName || 'upload.docx');\nbinary.fileName = originalName.replace(/\\.docx$/i, '') + '.zip';\nbinary.fileExtension = 'zip';\nbinary.mimeType = 'application/zip';\nitem.binary = { data: binary };\nreturn [item];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        112
      ],
      "id": "099545c8-5758-47c5-8f4a-e6e29bd430fc",
      "name": "Prepare DOCX Archive"
    }
