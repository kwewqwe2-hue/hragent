      "id": "c4eef1eb-03d3-4179-87d6-19131670d90e",
      "name": "Compression"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n  const entries = Object.entries(item.binary ?? {});\n  const match = entries.find(([, file]) => {\n    const fullName = [file.directory, file.fileName]\n      .filter(Boolean)\n      .join('/')\n      .replace(/\\\\/g, '/')\n      .toLowerCase();\n\n    return fullName.endsWith('word/document.xml');\n  });\n\n  if (!match) {\n    throw new Error('无法在 DOCX 中找到 word/document.xml，请确认文件未损坏且不是旧版 .doc 文件');\n  }\n\n  item.binary = { data: match[1] };\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1664,
        112
      ],
      "id": "b39e302a-c55a-45b7-9874-a50db20ac00e",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "operation": "xml",
        "destinationKey": "xml",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        1872,
        112
      ],
      "id": "4e7213a7-74ed-474e-8a34-2bed61495953",
      "name": "Extract from File2"
    },
    {
      "parameters": {
        "jsCode": "function decodeXml(value) {\n  return value\n    .replace(/&#x([0-9a-f]+);/gi, (_, hex) => String.fromCodePoint(Number.parseInt(hex, 16)))\n    .replace(/&#([0-9]+);/g, (_, decimal) => String.fromCodePoint(Number.parseInt(decimal, 10)))\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&apos;/g, \"'\")\n    .replace(/&amp;/g, '&');\n}\n\nconst source = $('Switch').first().json;\nconst fileName = String(source.fileName || 'upload.bin');\nconst maxChars = 60000;\n\nreturn $input.all().map((item) => {\n  const xml = String(item.json.xml || '');\n  const parts = Array.from(xml.matchAll(/<w:t(?:\\s[^>]*)?>([\\s\\S]*?)<\\/w:t>/g))\n    .map((match) => decodeXml(match[1]));\n  const rawText = parts.join(' ').replace(/\\s+/g, ' ').trim();\n\n  if (!rawText) {\n    throw new Error('DOCX 中没有提取到可读文字；图片型或损坏文件暂不支持');\n  }\n\n  return {\n    json: {\n      fileName,\n      fileType: 'docx',\n      extractedText: rawText.slice(0, maxChars),\n      truncated: rawText.length > maxChars,\n      originalLength: rawText.length,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        112
      ],
      "id": "cb9e15fd-1595-4beb-8e91-c6c2a42d7f92",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const source = $('Switch').first().json;\nconst fileName = String(source.fileName || 'upload.bin');\nconst maxChars = 60000;\n\nreturn $input.all().map((item) => {\n  const rawText = String(item.json.text ?? '').trim();\n\n  if (!rawText) {\n    throw new Error('PDF 中没有提取到可读文字；扫描件、图片型或加密 PDF 暂不支持');\n  }\n\n  return {\n    json: {\n      fileName,\n      fileType: 'pdf',\n      extractedText: rawText.slice(0, maxChars),\n      truncated: rawText.length > maxChars,\n      originalLength: rawText.length,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        -112
      ],
      "id": "d6c0bb9a-5959-47d4-b34e-fe6cfa3db03c",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "jsCode": "const source = $('Switch').first().json;\nconst fileName = String(source.fileName || 'upload.bin');\nconst maxChars = 60000;\n\nreturn $input.all().map((item) => {\n  const rawText = String(item.json.text ?? '').trim();\n\n  if (!rawText) {\n    throw new Error('TXT 文件为空或无法按文本编码读取');\n  }\n\n  return {\n    json: {\n      fileName,\n      fileType: 'txt',\n      extractedText: rawText.slice(0, maxChars),\n      truncated: rawText.length > maxChars,\n      originalLength: rawText.length,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        0
      ],
      "id": "f49db0ab-9389-4b12-9463-85fc6cb0c128",
      "name": "Code in JavaScript3"
    },
    {
      "parameters": {
        "jsCode": "const source = $('Switch').first().json;\nconst fileName = String(source.fileName || 'upload.bin');\n\nreturn [{\n  json: {\n    fileName,\n    fileType: 'unsupported',\n    error: '暂仅支持 JPG、JPEG、PNG、PDF、TXT 和 DOCX 文件；不支持旧版 DOC。扫描或图片型 PDF 请先转成图片上传。',\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1296,
        352
      ],
      "id": "75d7c434-c302-4b57-8894-b54116a33fde",
      "name": "Code in JavaScript4"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ocr:8000/ocr-file",
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "timeout": 60000
        }
