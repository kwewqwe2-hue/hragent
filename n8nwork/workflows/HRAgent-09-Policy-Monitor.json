                                         "jsCode":  "const response = $input.first().json || {};\nconst policy = response.data || response;\nif (!policy.sourceId || !policy.version || !policy.contentHash || !policy.title || !policy.content) {\n  throw new Error(\u0027Policy source response is missing required fields\u0027);\n}\nreturn [{ json: {\n  sourceId: String(policy.sourceId),\n  sourceName: String(policy.sourceName || \u0027Demo policy source\u0027),\n  sourceUrl: \u0027http://localhost:5173/policy-source-demo\u0027,\n  title: String(policy.title),\n  version: String(policy.version),\n  region: policy.region || null,\n  publishedAt: policy.publishedAt || null,\n  effectiveAt: policy.effectiveAt || null,\n  summary: policy.summary || null,\n  content: String(policy.content),\n  changeSummary: policy.changeSummary || null,\n  contentHash: String(policy.contentHash).toLowerCase(),\n  sourceUpdatedAt: policy.sourceUpdatedAt || null\n} }];"
