# Stable values generated on first setup. Never replace them after credentials
# and encrypted n8n data have been created.
N8N_POSTGRES_PASSWORD=replace-with-a-long-random-password
N8N_ENCRYPTION_KEY=replace-with-a-stable-random-key-at-least-32-characters

# Local n8n editor
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# DingTalk internal application
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_APPROVAL_BASE_URL=

# SaaS and RAG services inside Docker
SAAS_BASE_URL=http://hragent-backend:8080/api
QDRANT_URL=http://qdrant:6333
KNOWLEDGE_STORAGE_PATH=/knowledge-files
OLLAMA_BASE_URL=http://ollama:11434
RAG_EMBEDDING_MODEL=bge-m3

# Docker Desktop exposes its configured proxy through port 3128. When using a
# proxy application directly, replace these four values with
# http://host.docker.internal:<proxy-port> and enable LAN access in that app.
N8N_HTTP_PROXY=http://http.docker.internal:3128
N8N_HTTPS_PROXY=http://http.docker.internal:3128
OLLAMA_HTTP_PROXY=http://http.docker.internal:3128
OLLAMA_HTTPS_PROXY=http://http.docker.internal:3128

# Must equal HRAGENT_WEB_ATTACHMENT_INTERNAL_KEY in ../hragentv1/.env.
HRAGENT_WEB_ATTACHMENT_INTERNAL_KEY=replace-with-a-long-random-secret

# Optional named Cloudflare Tunnel. Quick Tunnel does not use this token.
CLOUDFLARED_TUNNEL_TOKEN=
