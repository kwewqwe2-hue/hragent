# MySQL demo database
MYSQL_DATABASE=hragent
MYSQL_ROOT_PASSWORD=replace-with-a-random-password
MYSQL_USER=hragent
MYSQL_PASSWORD=replace-with-a-random-password

# Optional direct backend model access. The main agent uses the n8n credential.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Generated automatically by scripts/initialize-hragent-config.ps1.
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret
HRAGENT_WEB_CHAT_IDENTITY_SECRET=replace-with-a-long-random-secret
HRAGENT_WEB_ATTACHMENT_INTERNAL_KEY=replace-with-a-long-random-secret

# Internal container URLs
N8N_WEB_CHAT_WEBHOOK_URL=http://hragent-n8n:5678/webhook/hragent-dingtalk-8a2d811d-0fe5-4198-8e61-288ec417fc04
N8N_WEB_ATTACHMENT_PARSE_URL=http://hragent-n8n:5678/webhook/hragent-web-attachment-parse
N8N_WEB_CHAT_CALLBACK_BASE_URL=http://hragent-backend:8080/api
N8N_KNOWLEDGE_UPLOAD_URL=http://hragent-n8n:5678/webhook/hragent-knowledge-ingest
N8N_KNOWLEDGE_DELETE_URL=http://hragent-n8n:5678/webhook/hragent-knowledge-delete

# Demo certificate issuer information
CERTIFICATE_COMPANY_ADDRESS=北京市海淀区中关村示例科技园 1 号
CERTIFICATE_COMPANY_CONTACT=010-88886666
